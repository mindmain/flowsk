# ==============================================================================
# Flowsk Environment Configuration Template (`.env.example`)
# ==============================================================================
# Copy this file to `.env` for local overrides (`cp .env.example .env`).
# `.env` and `.env.*` are gitignored; never commit real tokens or DSN secrets.
# All Flowsk runtime settings use the `FLOWSK_` prefix and are bound via Viper
# in `internal/config`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & ConnectRPC HTTP Transport (`flowsk serve`)
# ------------------------------------------------------------------------------
# Host port published by `docker-compose.yml` -> container `:8080`.
FLOWSK_PORT=8080

# Bind address inside the `flowsk serve` process (supports HTTP/1.1 + h2c).
FLOWSK_HTTP_ADDR=:8080

# Structured logger verbosity (`debug`, `info`, `warn`, `error`) and encoding (`json`, `text`).
FLOWSK_LOG_LEVEL=info
FLOWSK_LOG_FORMAT=json

# Optional bearer secret enforced by ConnectRPC and HTTP MCP auth interceptors.
# Leave empty for trusted localhost / single-developer Docker usage.
FLOWSK_AUTH_TOKEN=

# Default workspace slug used when client requests omit an explicit workspace header/flag.
FLOWSK_DEFAULT_WORKSPACE=default

# Automatically apply embedded/bundled Goose database migrations on server startup.
FLOWSK_AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# 2. Persistence Engine & Shared SQLite Volume (`internal/adapter/db/*` & `volume`)
# ------------------------------------------------------------------------------
# Active persistence adapter: `sqlite` (default) or `postgres`.
FLOWSK_DB_DRIVER=sqlite

# Shared directory holding SQLite DB files, advisory locks, and backups.
# Inside Docker this maps to the `flowsk_data` volume at `/data/flowsk`.
FLOWSK_VOLUME_DIR=/data/flowsk

# File path of the SQLite database (runs in WAL mode with foreign keys enabled).
FLOWSK_SQLITE_PATH=/data/flowsk/flowsk.db

# SQLite busy timeout in milliseconds for concurrent readers/writers on shared volumes.
FLOWSK_SQLITE_BUSY_TIMEOUT_MS=5000

# Number of rolling SQLite snapshot files retained inside `${FLOWSK_VOLUME_DIR}/snapshots`.
FLOWSK_VOLUME_SNAPSHOT_RETENTION=10

# ------------------------------------------------------------------------------
# 3. Optional PostgreSQL Office Deployment (`docker compose --profile postgres`)
# ------------------------------------------------------------------------------
# Set `FLOWSK_DB_DRIVER=postgres` and uncomment `FLOWSK_POSTGRES_DSN` to switch
# from SQLite to PostgreSQL with zero domain/transport changes:
# FLOWSK_DB_DRIVER=postgres
# FLOWSK_POSTGRES_DSN=postgres://flowsk:flowsk@postgres:5432/flowsk?sslmode=disable
FLOWSK_POSTGRES_DSN=
FLOWSK_POSTGRES_MAX_CONNS=16

# PostgreSQL container bootstrap variables (used by `docker-compose.yml` `--profile postgres`).
POSTGRES_USER=flowsk
POSTGRES_PASSWORD=flowsk
POSTGRES_DB=flowsk
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Model Context Protocol (MCP) Server (`flowsk mcp serve`)
# ------------------------------------------------------------------------------
# MCP transport mode: `stdio` (default for local IDE/agent subprocesses) or `http`.
FLOWSK_MCP_TRANSPORT=stdio

# Bind address when `FLOWSK_MCP_TRANSPORT=http` is selected.
FLOWSK_MCP_HTTP_ADDR=:8081

# ------------------------------------------------------------------------------
# 5. CLI & Client Defaults (Local-First + Optional Network Mode)
# ------------------------------------------------------------------------------
# Local SQLite database path used when FLOWSK_SERVER_URL is empty (Zero-Setup Local Mode).
FLOWSK_DB_PATH=~/.local/share/flowsk/flowsk.db

# Optional remote Flowsk ConnectRPC base URL (e.g. http://127.0.0.1:8080 or
# http://flowsk.lan:8080) allowing other machines, containers, or remote servers
# to connect over the network to a shared `flowsk serve` instance.
# Leave empty to operate purely locally against FLOWSK_DB_PATH.
FLOWSK_SERVER_URL=

# Active workspace slug for CLI / MCP calls.
FLOWSK_WORKSPACE=default

# Default terminal/agent output format (`auto`, `human`, `compact`, `tsv`, `jsonl`, `json`, `md`).
# `auto` renders aligned tables and goal progress bars in interactive terminals (`human`)
# and ultra-low-token symbolic lines (`compact`) when piped or called by AI agents.
FLOWSK_FORMAT=auto

# Client-only local directory registry mapping logical `project_id`/`slug` to
# developer host directories. Strictly client-local: paths in this file are NEVER
# written inside target Git repositories and NEVER transmitted to the server.
FLOWSK_LOCAL_PATHS_FILE=~/.config/flowsk/local_paths.json
